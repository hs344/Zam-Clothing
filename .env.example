# ---------------------------------------------------------------------------
# ZAM CLOTHING — configuration
# Copy to .env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Local database (only used for demo-mode orders while Google Sheets is not connected)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Google Apps Script Web App URL (ends with /exec). Leave EMPTY to run in demo mode.
# Once set, products, categories, inventory, settings and orders all come from Google Sheets.
APPS_SCRIPT_URL=

# Optional shared secret. Must match API_KEY inside google-apps-script/Code.gs.
APPS_SCRIPT_API_KEY=

# Fallback WhatsApp settings, used only when the SETTINGS sheet has no whatsapp_number.
# Country code + number, digits only (e.g. 919876543210).
WHATSAPP_NUMBER=
WHATSAPP_ENABLED=false
